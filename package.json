{
  "name": "dingtalk-echo",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal DingTalk Stream text echo bot",
  "type": "module",
  "packageManager": "npm@12.2.0",
  "engines": { "node": ">=24.21.0 <25", "npm": ">=12.2.0 <13" },
  "allowScripts": {},
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "check": "npm run build && node dist/cli.js --check",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": { "@types/node": "24.19.2", "typescript": "7.0.2", "ws": "8.22.0" }
}
